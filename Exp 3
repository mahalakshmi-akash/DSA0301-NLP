text = "The boys are playing happily in the playground."

words = text.split()

print("Original Words:")
print(words)

print("\nMorphological Analysis (Simple Stemming):")

for word in words:
    stem = word
    if stem.endswith("ing"):
        stem = stem[:-3]
    elif stem.endswith("ly"):
        stem = stem[:-2]
    elif stem.endswith("s"):
        stem = stem[:-1]

    print(word, "->", stem)

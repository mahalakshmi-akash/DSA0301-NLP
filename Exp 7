sentence = "The quick brown fox jumps over the lazy dog"

words = sentence.split()

print("Word\t\tPOS Tag")
print("------------------------")

for word in words:
    if word.lower() in ["the", "a", "an"]:
        tag = "DT (Determiner)"
    elif word.lower() in ["over", "in", "on", "at", "under"]:
        tag = "IN (Preposition)"
    elif word.endswith("ing"):
        tag = "VBG (Verb)"
    elif word.lower() in ["jumps", "runs", "plays"]:
        tag = "VBZ (Verb)"
    elif word.lower() in ["quick", "brown", "lazy"]:
        tag = "JJ (Adjective)"
    else:
        tag = "NN (Noun)"

    print(word, "\t\t", tag)

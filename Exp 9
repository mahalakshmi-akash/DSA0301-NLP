import re

patterns = [
    (r'.*ing$', 'VBG'),
    (r'.*ed$', 'VBD'),
    (r'.*es$', 'VBZ'),
    (r'.*ould$', 'MD'),
    (r".*'s$", 'NN$'),
    (r'.*s$', 'NNS'),
    (r'^[0-9]+$', 'CD'),
    (r'.*', 'NN')
]

sentence = "The boys are playing football"

words = sentence.split()

print("Word\t\tPOS Tag")
print("-------------------------")

for word in words:
    for pattern, tag in patterns:
        if re.match(pattern, word):
            print(word, "\t\t", tag)
            break



words = ["running", "playing", "studies", "happiness", "flies"]

print("Word\t\tStem")

for word in words:
    stem = word

    if stem.endswith("ing"):
        stem = stem[:-3]
    elif stem.endswith("ies"):
        stem = stem[:-3] + "y"
    elif stem.endswith("ness"):
        stem = stem[:-4]
    elif stem.endswith("es"):
        stem = stem[:-2]
    elif stem.endswith("s"):
        stem = stem[:-1]

    print(word, "\t\t", stem)
